# PlatformIO / build output
.pio/
build/
dist/
*.o
*.obj
*.elf
*.map

# Editor-generated files (keep shared VS Code settings and recommendations)
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/
.idea/
*.code-workspace
*.swp
*.swo
*~
.history/

# macOS metadata
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100/
.Trashes/
.fseventsd/
.TemporaryItems/
.VolumeIcon.icns

# Windows metadata
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.stackdump

# Temporary files, logs, and local caches
*.log
*.tmp
*.temp
*.bak
*.orig
*.rej
.cache/
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Generated ESP-IDF configuration is not used by this Arduino-only template.
sdkconfig.*
# Keep intentional, reusable ESP-IDF defaults if added later.
!sdkconfig.defaults
!sdkconfig.defaults.*

# Local environment variables; allow sanitized examples to be committed.
.env
.env.*
!.env.example
!.env.sample
!.env.template
.envrc

# Local credentials and secrets (never put real values in example files)
include/secrets.h
secrets.h
secrets.json
secrets.yaml
secrets.yml
credentials.json
credentials.yaml
credentials.yml
secrets/
.secrets/
.aws/
.ssh/
.netrc
_netrc
.npmrc
.pypirc

# Private keys, certificate bundles, and firmware signing/encryption keys
*.key
*.p12
*.pfx
*.jks
*.keystore
*.private.pem
*-private.pem
*_private.pem
id_rsa
id_dsa
id_ecdsa
id_ed25519
secure_boot_signing_key*.pem
flash_encryption_key*.bin

# Local compilation databases, captures, and credential variants
compile_commands.json
*.bin
*.hex
*.uf2
*.opusbin
*.pcm
*.dump
*.core
secrets.toml
credentials.toml
.netrc.gpg
*.kdbx
